<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="geco_whatsapp.SendGecoWhatsappButton">
        <a
            title="Enviar por WhatsApp"
            href="#"
            t-on-click.prevent.stop="onClick"
            class="ms-3 d-inline-flex align-items-center o_field_phone_geco_whatsapp"
        ><i class="fa fa-whatsapp"></i><small class="fw-bold ms-1">WhatsApp</small></a>
    </t>

    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]//a" position="after">
            <t t-if="props.enableGecoWhatsapp and props.record.data[props.name].length > 0">
                <SendGecoWhatsappButton t-props="props" />
            </t>
        </xpath>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-if="props.enableGecoWhatsapp and props.record.data[props.name].length > 0">
                <SendGecoWhatsappButton t-props="props" />
            </t>
        </xpath>
    </t>

</templates>
