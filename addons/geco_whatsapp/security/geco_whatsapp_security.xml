<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="geco_whatsapp_account_company_rule" model="ir.rule">
        <field name="name">GECO WhatsApp Account Multi-Company</field>
        <field name="model_id" ref="model_geco_whatsapp_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="geco_whatsapp_ignore_company_rule" model="ir.rule">
        <field name="name">GECO WhatsApp Ignore List Multi-Company</field>
        <field name="model_id" ref="model_geco_whatsapp_ignore"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</data>
</odoo>
