<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geco_whatsapp_account_tree" model="ir.ui.view">
        <field name="name">geco.whatsapp.account.tree</field>
        <field name="model">geco.whatsapp.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="phone"/>
                <field name="microservice_url"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'connected'"
                       decoration-warning="status in ('starting', 'qr')"
                       decoration-danger="status == 'error'"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_geco_whatsapp_account_form" model="ir.ui.view">
        <field name="name">geco.whatsapp.account.form</field>
        <field name="model">geco.whatsapp.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register" type="object" string="Registrar en el microservicio" class="btn-primary"/>
                    <button name="action_view_qr" type="object" string="Vincular WhatsApp (QR)" class="btn-primary"
                            invisible="status == 'connected'"/>
                    <button name="action_refresh_status" type="object" string="Actualizar estado"/>
                    <button name="action_stop" type="object" string="Detener sesión" invisible="status not in ('qr', 'connected', 'starting')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,qr,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la cuenta"/></h1>
                    </div>
                    <group>
                        <group string="Conexión">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="microservice_url"/>
                            <field name="external_account_id"/>
                            <field name="internal_token" password="True"/>
                            <field name="default_country_code"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group string="Estado">
                            <field name="phone"/>
                            <field name="webhook_secret" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geco_whatsapp_account" model="ir.actions.act_window">
        <field name="name">Cuentas de WhatsApp</field>
        <field name="res_model">geco.whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay cuentas de WhatsApp registradas.
            </p>
            <p>
                Crea una cuenta, indica la URL de tu microservicio y da clic en
                "Registrar en el microservicio" para vincular el número por QR.
            </p>
        </field>
    </record>

    <menuitem id="menu_geco_whatsapp_accounts"
              name="Cuentas"
              parent="menu_geco_whatsapp_root"
              action="action_geco_whatsapp_account"
              groups="base.group_system"
              sequence="15"/>

</odoo>
