<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geco_whatsapp_log_tree" model="ir.ui.view">
        <field name="name">geco.whatsapp.log.tree</field>
        <field name="model">geco.whatsapp.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="not success">
                <field name="create_date" string="Fecha"/>
                <field name="direction"/>
                <field name="content_type"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="detail"/>
                <field name="raw_payload" string="JSON crudo" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_geco_whatsapp_log_form" model="ir.ui.view">
        <field name="name">geco.whatsapp.log.form</field>
        <field name="model">geco.whatsapp.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Fecha"/>
                            <field name="direction"/>
                            <field name="content_type"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="detail" nolabel="1"/>
                    </group>
                    <group string="JSON crudo del payload">
                        <field name="raw_payload" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_geco_whatsapp_log_search" model="ir.ui.view">
        <field name="name">geco.whatsapp.log.search</field>
        <field name="model">geco.whatsapp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <filter name="only_errors" string="Solo errores" domain="[('success', '=', False)]"/>
                <filter name="outbound" string="Salientes" domain="[('direction', '=', 'outbound')]"/>
                <filter name="inbound" string="Entrantes" domain="[('direction', '=', 'inbound')]"/>
                <filter name="content_location" string="Ubicación" domain="[('content_type', '=', 'location')]"/>
                <filter name="content_contact" string="Contacto" domain="[('content_type', '=', 'contact')]"/>
                <filter name="content_event" string="Evento" domain="[('content_type', '=', 'event')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_direction" string="Tipo" context="{'group_by': 'direction'}"/>
                    <filter name="group_content_type" string="Contenido" context="{'group_by': 'content_type'}"/>
                    <filter name="group_account" string="Cuenta" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_geco_whatsapp_log" model="ir.actions.act_window">
        <field name="name">Bitácora de WhatsApp</field>
        <field name="res_model">geco.whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_geco_whatsapp_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay actividad registrada.
            </p>
            <p>
                Aquí queda cada envío, mensaje recibido, cambio de estado de cuenta y
                webhook rechazado, con su detalle de error si algo falló.
            </p>
        </field>
    </record>

    <menuitem id="menu_geco_whatsapp_log"
              name="Bitácora"
              parent="menu_geco_whatsapp_root"
              action="action_geco_whatsapp_log"
              groups="base.group_system"
              sequence="25"/>

</odoo>
