<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geco_whatsapp_ignore_tree" model="ir.ui.view">
        <field name="name">geco.whatsapp.ignore.tree</field>
        <field name="model">geco.whatsapp.ignore</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="phone"/>
                <field name="reason"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_geco_whatsapp_ignore" model="ir.actions.act_window">
        <field name="name">Números ignorados</field>
        <field name="res_model">geco.whatsapp.ignore</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay números ignorados.
            </p>
            <p>
                Los mensajes entrantes de un número en esta lista se descartan por
                completo: no se crea contacto ni se registra en el chatter (solo queda
                una entrada informativa en la Bitácora).
            </p>
        </field>
    </record>

    <menuitem id="menu_geco_whatsapp_ignore"
              name="Números ignorados"
              parent="menu_geco_whatsapp_root"
              action="action_geco_whatsapp_ignore"
              groups="base.group_system"
              sequence="30"/>

</odoo>
