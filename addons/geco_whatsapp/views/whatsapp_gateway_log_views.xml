<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geco_whatsapp_gateway_log_tree" model="ir.ui.view">
        <field name="name">geco.whatsapp.gateway.log.tree</field>
        <field name="model">geco.whatsapp.gateway.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="not success">
                <field name="create_date" string="Fecha"/>
                <field name="direction"/>
                <field name="content_type"/>
                <field name="account_id"/>
                <field name="phone"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="view_geco_whatsapp_gateway_log_search" model="ir.ui.view">
        <field name="name">geco.whatsapp.gateway.log.search</field>
        <field name="model">geco.whatsapp.gateway.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="account_id"/>
                <filter name="only_errors" string="Solo errores" domain="[('success', '=', False)]"/>
                <filter name="inbound" string="Entrantes" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Salientes" domain="[('direction', '=', 'outbound')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_direction" string="Tipo" context="{'group_by': 'direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_geco_whatsapp_gateway_log" model="ir.actions.act_window">
        <field name="name">Bitácora del microservicio</field>
        <field name="res_model">geco.whatsapp.gateway.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_geco_whatsapp_gateway_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay actividad registrada por el microservicio.
            </p>
            <p>
                Esto es lo que el microservicio de Node registró directamente — conexión,
                mensajes que le llegaron de WhatsApp, envíos y entregas de webhook — sin
                pasar por GECOERP. Sirve para confirmar si algo llegó al microservicio
                aunque no haya llegado a la Bitácora de GECOERP (p.ej. si el webhook falló).
            </p>
        </field>
    </record>

    <menuitem id="menu_geco_whatsapp_gateway_log"
              name="Bitácora del microservicio"
              parent="menu_geco_whatsapp_root"
              action="action_geco_whatsapp_gateway_log"
              groups="base.group_system"
              sequence="26"/>

</odoo>
