<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geco_whatsapp_compose_form" model="ir.ui.view">
        <field name="name">geco.whatsapp.compose.form</field>
        <field name="model">geco.whatsapp.compose</field>
        <field name="arch" type="xml">
            <form string="Enviar por WhatsApp">
                <group>
                    <field name="wa_template_id" invisible="not res_model or res_model == 'res.partner'"/>
                    <field name="partner_id" readonly="res_model == 'res.partner'"/>
                    <field name="phone" readonly="res_model == 'res.partner'"/>
                    <field name="message"/>
                    <field name="include_attachment" invisible="not has_report"/>
                    <field name="has_report" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_geco_whatsapp_compose" model="ir.actions.act_window">
        <field name="name">Enviar por WhatsApp</field>
        <field name="res_model">geco.whatsapp.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
