<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Plantillas semilla -->
    <record id="whatsapp_template_invoice" model="geco.whatsapp.template">
        <field name="name">Factura</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="phone_field">partner_id.mobile</field>
        <field name="report_id" ref="account.account_invoices"/>
        <field name="body">Hola {{ object.partner_id.name }}, te compartimos tu factura {{ object.name }}. ¡Gracias por tu preferencia!</field>
    </record>

    <record id="whatsapp_template_quotation" model="geco.whatsapp.template">
        <field name="name">Cotización</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="phone_field">partner_id.mobile</field>
        <field name="report_id" ref="sale.action_report_saleorder"/>
        <field name="body">Hola {{ object.partner_id.name }}, te compartimos tu cotización {{ object.name }}. Quedamos atentos a tus comentarios.</field>
    </record>

    <!-- Botón "Enviar por WhatsApp" data-driven: aparece solo en cualquier modelo con plantilla -->
    <record id="action_geco_whatsapp_compose_move" model="ir.actions.act_window">
        <field name="name">Enviar por WhatsApp</field>
        <field name="res_model">geco.whatsapp.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="action_geco_whatsapp_compose_sale" model="ir.actions.act_window">
        <field name="name">Enviar por WhatsApp</field>
        <field name="res_model">geco.whatsapp.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>

    <record id="action_geco_whatsapp_compose_partner" model="ir.actions.act_window">
        <field name="name">Enviar por WhatsApp</field>
        <field name="res_model">geco.whatsapp.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
