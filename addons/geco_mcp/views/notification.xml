<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_notification_tree" model="ir.ui.view">
		<field name="name">geco_mcp.notification.tree</field>
		<field name="model">geco_mcp.notification</field>
		<field name="arch" type="xml">
			<list create="false">
				<field name="event_id"/>
				<field name="session_id"/>
				<field name="method"/>
				<field name="params"/>
				<field name="delivered"/>
				<field name="create_date"/>
			</list>
		</field>
	</record>

	<record id="action_mcp_notification" model="ir.actions.act_window">
		<field name="name">Notifications</field>
		<field name="res_model">geco_mcp.notification</field>
		<field name="view_mode">list</field>
	</record>

</odoo>
