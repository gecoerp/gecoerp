<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="geco_ai_core.Dashboard">
        <div class="o_action_manager">
            <div class="container-fluid py-4 bg-100 h-100 overflow-auto">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-primary fw-bold m-0"><i class="fa fa-bar-chart me-2"/>GECO AI Analytics</h2>
                    <button class="btn btn-outline-primary" t-on-click="loadStatistics">
                        <i class="fa fa-refresh me-1"/> Refrescar
                    </button>
                </div>
                
                <!-- KPIs -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted fw-bold text-uppercase mb-2">Consumo Mes Actual</h6>
                                <h3 class="fw-bolder text-dark mb-0">
                                    <t t-esc="state.stats.kpis.total_tokens_month.toLocaleString()"/>
                                    <small class="text-muted fs-6">/ <t t-esc="state.stats.kpis.token_limit > 0 ? state.stats.kpis.token_limit.toLocaleString() : '∞'"/></small>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted fw-bold text-uppercase mb-2">Promedio Diario</h6>
                                <h3 class="fw-bolder text-info mb-0">
                                    <t t-esc="state.stats.kpis.average_daily.toLocaleString()"/> <small class="text-muted fs-6">tokens</small>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted fw-bold text-uppercase mb-2">Proyección MLP (Redes Neuronales)</h6>
                                <h3 t-attf-class="fw-bolder mb-0 {{ state.stats.kpis.token_limit > 0 and state.stats.kpis.projected_month >= state.stats.kpis.token_limit ? 'text-danger' : 'text-success' }}">
                                    <t t-esc="state.stats.kpis.projected_month.toLocaleString()"/>
                                    <i t-if="state.stats.kpis.token_limit > 0 and state.stats.kpis.projected_month >= state.stats.kpis.token_limit" class="fa fa-warning ms-2"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100 bg-primary text-white">
                            <div class="card-body">
                                <h6 class="fw-bold text-uppercase mb-2" style="opacity: 0.8">Costo Estimado Mes</h6>
                                <h3 class="fw-bolder mb-0">
                                    $<t t-esc="state.stats.kpis.total_cost_usd.toFixed(2)"/> <small class="fs-6" style="opacity: 0.8">USD</small>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Charts -->
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold text-dark m-0">Tendencia de Uso (30 días)</h5>
                            </div>
                            <div class="card-body p-4">
                                <canvas t-ref="trendChart" height="100"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold text-dark m-0">Consumo por Módulo</h5>
                            </div>
                            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                                <canvas t-ref="moduleChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </t>
</templates>
