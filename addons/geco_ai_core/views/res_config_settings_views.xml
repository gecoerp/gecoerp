<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_geco_ai_core" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.geco.ai.core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="GECO AI Engine" id="geco_ai_core_settings_block">
                    <setting id="geco_ai_settings" string="Motor de Inteligencia Artificial" help="Configura los proveedores de IA para GECOERP">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="geco_ai_provider" class="col-lg-4 o_light_label"/>
                                <field name="geco_ai_provider" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="geco_openai_api_key" class="col-lg-4 o_light_label"/>
                                <field name="geco_openai_api_key" class="oe_inline" password="True"/>
                            </div>
                            <div class="row mt16">
                                <label for="geco_gemini_api_key" class="col-lg-4 o_light_label"/>
                                <field name="geco_gemini_api_key" class="oe_inline" password="True"/>
                            </div>
                            <div class="mt16" style="margin-left: 33%;">
                                <button name="%(geco_ai_core.action_geco_ai_test_wizard)d" string="⚡ Probar Conexión" type="action" class="btn-primary"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="geco_ai_budget_settings" string="Presupuesto y Alertas" help="Límites de uso y alertas por correo">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="geco_ai_token_limit" class="col-lg-4 o_light_label"/>
                                <field name="geco_ai_token_limit" class="oe_inline"/>
                            </div>
                            <div class="text-muted" style="margin-left: 33%; font-size: 0.9em;">
                                0 = Ilimitado. Se enviará una alerta al alcanzar el 90%.
                            </div>
                            <div class="row mt16">
                                <label for="geco_ai_alert_email" class="col-lg-4 o_light_label"/>
                                <field name="geco_ai_alert_email" class="oe_inline" placeholder="admin@miempresa.com"/>
                            </div>
                            <div class="row mt16">
                                <label for="geco_ai_cost_input_1m" class="col-lg-4 o_light_label"/>
                                <field name="geco_ai_cost_input_1m" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="geco_ai_cost_output_1m" class="col-lg-4 o_light_label"/>
                                <field name="geco_ai_cost_output_1m" class="oe_inline"/>
                            </div>
                            <div class="text-muted" style="margin-left: 33%; font-size: 0.9em;">
                                Costo en USD por cada 1 Millón de tokens (Prompt y Completado).
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
