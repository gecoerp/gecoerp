<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geco_ai_test_wizard_form" model="ir.ui.view">
        <field name="name">geco.ai.test.wizard.form</field>
        <field name="model">geco.ai.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Verificar Conexión GECO AI">
                <field name="status" invisible="1"/>
                
                <!-- Banners informativos -->
                <div class="alert alert-info text-center" role="alert" invisible="status != 'draft'">
                    <i class="fa fa-info-circle mr-1" title="Info"/> Selecciona el proveedor de Inteligencia Artificial y haz clic en <strong>Probar Conexión</strong>.
                </div>
                <div class="alert alert-success text-center" role="alert" invisible="status != 'success'">
                    <i class="fa fa-check-circle mr-1" title="Éxito"/> <strong>¡Conexión Exitosa!</strong> El motor de IA está respondiendo adecuadamente.
                </div>
                <div class="alert alert-danger" role="alert" invisible="status != 'error'">
                    <i class="fa fa-exclamation-triangle mr-1" title="Error"/> <strong>Error de Conexión.</strong> No se pudo establecer la comunicación con el proveedor. Revisa tus API keys en Ajustes.
                </div>

                <group>
                    <group string="Configuración de Prueba">
                        <field name="provider" widget="radio" options="{'horizontal': true}"/>
                        <field name="prompt" placeholder="Escribe algo para enviarlo a la IA..." style="min-height: 80px;"/>
                    </group>
                    <group string="Consola del Estado" invisible="status == 'draft'">
                        <field name="status_message" string="Resultado" class="text-info font-weight-bold" readonly="1" invisible="status != 'success'"/>
                        <field name="status_message" string="Detalle de Error" class="text-danger font-weight-bold" readonly="1" invisible="status != 'error'"/>
                    </group>
                </group>

                <notebook invisible="status == 'draft'">
                    <page string="Respuesta Obtenida" name="response_page">
                        <field name="response" widget="text" placeholder="Esperando respuesta..." style="font-family: monospace; font-size: 1.1em; background-color: #f8f9fa; min-height: 150px;" readonly="1"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_test_connection" string="Probar Conexión" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_geco_ai_test_wizard" model="ir.actions.act_window">
        <field name="name">Verificar Conexión GECO AI</field>
        <field name="res_model">geco.ai.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
