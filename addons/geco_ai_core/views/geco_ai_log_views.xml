<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_geco_ai_log_tree" model="ir.ui.view">
        <field name="name">geco.ai.log.list</field>
        <field name="model">geco.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI Consumption Logs" default_order="create_date desc" decoration-info="provider=='openai'" decoration-success="provider=='gemini'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="module_caller"/>
                <field name="provider"/>
                <field name="model_used"/>
                <field name="tokens_total" sum="Total Tokens"/>
                <field name="cost_estimate" string="USD" sum="Total USD" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="1"/>
                <field name="cost_mxn" string="Costo (MXN)" sum="Total MXN"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_geco_ai_log_form" model="ir.ui.view">
        <field name="name">geco.ai.log.form</field>
        <field name="model">geco.ai.log</field>
        <field name="arch" type="xml">
            <form string="AI Log Detail">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="module_caller"/>
                        </group>
                        <group>
                            <field name="provider"/>
                            <field name="model_used"/>
                            <field name="tokens_total"/>
                            <field name="cost_mxn" string="Costo (MXN)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prompt (Sent to AI)">
                            <field name="prompt" widget="text"/>
                        </page>
                        <page string="Response (From AI)">
                            <field name="response" widget="text"/>
                        </page>
                        <page string="Token Details">
                            <group>
                                <field name="tokens_prompt"/>
                                <field name="tokens_completion"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pivot View for Statistics -->
    <record id="view_geco_ai_log_pivot" model="ir.ui.view">
        <field name="name">geco.ai.log.pivot</field>
        <field name="model">geco.ai.log</field>
        <field name="arch" type="xml">
            <pivot string="AI Token Consumption" display_quantity="true">
                <field name="user_id" type="row"/>
                <field name="provider" type="col"/>
                <field name="tokens_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Statistics -->
    <record id="view_geco_ai_log_graph" model="ir.ui.view">
        <field name="name">geco.ai.log.graph</field>
        <field name="model">geco.ai.log</field>
        <field name="arch" type="xml">
            <graph string="AI Token Consumption" type="bar">
                <field name="create_date" interval="day"/>
                <field name="provider"/>
                <field name="tokens_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_geco_ai_log" model="ir.actions.act_window">
        <field name="name">AI Consumption Logs</field>
        <field name="res_model">geco.ai.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
