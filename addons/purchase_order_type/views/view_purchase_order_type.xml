<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_order_type_tree" model="ir.ui.view">
        <field name="model">purchase.order.type</field>
        <field name="arch" type="xml">
            <list name="Purchase Order Types" decoration-muted="active == False">
                <field name="sequence" widget="handle" />
                <field name="active" column_invisible="1" />
                <field name="billing_period_unit" column_invisible="True" />
                <field name="name" />
                <field name="is_periodic" widget="boolean_toggle" string="Recurrente" />
                <field name="billing_period_display" widget="badge" decoration-info="billing_period_unit == 'month'" decoration-warning="billing_period_unit == 'year'" decoration-success="billing_period_unit in ('week', 'days')" />
                <field name="estimated_periodic_amount" optional="show" />
                <field name="mrr_amount" optional="show" string="MRR (Gasto Mensual)" />
                <field name="sequence_id" />
                <field name="payment_term_id" />
                <field name="incoterm_id" />
                <field name="description" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_purchase_order_type_form" model="ir.ui.view">
        <field name="model">purchase.order.type</field>
        <field name="arch" type="xml">
            <form string="Type">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="ej. Planeadas Mensual, Regular..." />
                        </h1>
                    </div>
                    <group>
                        <group name="general_config">
                            <field name="sequence_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group name="commercial_config">
                            <field name="payment_term_id" />
                            <field name="incoterm_id" />
                            <field name="is_periodic" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page name="subscription_plan_page" string="Plan de Recurrencia / Suscripción" invisible="not is_periodic">
                            <group>
                                <group name="recurrence_details" string="Período de Facturación">
                                    <label for="billing_period_value" string="Intervalo de Recurrencia"/>
                                    <div class="d-flex flex-row align-items-center gap-2">
                                        <field name="billing_period_value" style="width: 5rem;" />
                                        <field name="billing_period_unit" />
                                    </div>
                                    <field name="billing_period_display" readonly="1" />
                                    <field name="billing_first_day" invisible="billing_period_unit in ('days', 'week')" />
                                    <field name="provision_day_of_month" />
                                </group>
                                <group name="automation_details" string="Automatización &amp; Tolerancia">
                                    <label for="auto_close_limit" string="Días de Gracia"/>
                                    <div class="d-flex flex-row align-items-center gap-2">
                                        <field name="auto_close_limit" style="width: 5rem;" />
                                        <span>Días tras vencimiento</span>
                                    </div>
                                    <field name="mail_template_id" options="{'no_create': True}" />
                                </group>
                            </group>
                        </page>
                        <page name="cash_flow_page" string="Flujo de Efectivo &amp; MRR" invisible="not is_periodic">
                            <group>
                                <group name="cash_flow_grp" string="Proyección de Tesorería">
                                    <field name="cash_flow_impact" widget="boolean_toggle" />
                                    <field name="estimated_periodic_amount" widget="monetary" />
                                    <field name="currency_id" invisible="1" />
                                </group>
                                <group name="mrr_grp" string="Cálculo Normalizado (MRR)">
                                    <field name="mrr_amount" widget="monetary" readonly="1" />
                                    <div class="text-muted small" colspan="2">
                                        * El Gasto Mensual Recurrente (MRR) se calcula automáticamente para permitir la comparación homogénea de flujos semanales, quincenales, mensuales y anuales.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page name="description_page" string="Descripción Operativa">
                            <field name="description" placeholder="Ejemplos operativos de compras, insumos y servicios que pertenecen a este tipo..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_purchase_order_type_search" model="ir.ui.view">
        <field name="model">purchase.order.type</field>
        <field name="arch" type="xml">
            <search string="Purchase Order Types">
                <field name="name" />
                <field name="sequence_id" />
                <field name="payment_term_id" />
                <field name="incoterm_id" />
                <group expand="0" string="Group By">
                    <filter
                        string="Entry Sequence"
                        name="entry_sequence"
                        domain="[]"
                        context="{'group_by':'sequence_id'}"
                    />
                    <filter
                        string="Payment Term"
                        name="pay_terms"
                        domain="[]"
                        context="{'group_by':'payment_term_id'}"
                    />
                    <filter
                        string="Incoterm"
                        name="incoterm"
                        domain="[]"
                        context="{'group_by':'incoterm_id'}"
                    />
                    <filter
                        string="Company"
                        name="company"
                        domain="[]"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_purchase_order_type_view">
        <field name="name">Purchase Order Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order.type</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_purchase_order_type_tree" />
        <field name="search_view_id" ref="view_purchase_order_type_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to set a new type for purchase order.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_purchase_order_type"
        parent="purchase.menu_purchase_config"
        sequence="40"
        action="action_purchase_order_type_view"
    />
</odoo>
