<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_purchaseorder_document_deliver_to" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_deliver_to" class="text-start"><strong>Deliver To</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td name="td_deliver_to" class="text-start">
                <span t-field="line.picking_type_id.display_name"/>
            </td>
        </xpath>
    </template>
</odoo>
