<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_inherit_form_purchase_receipt_by_date" model="ir.ui.view">
        <field name="name">stock.picking.inherit.form.purchase.receipt.by.date</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='return_picking_type_id']" position="after">
                <field name="default_location_dest_id" invisible="code in ['incoming', 'outgoing', 'internal']"/>
            </xpath>
        </field>
    </record>
</odoo>
