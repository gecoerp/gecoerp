<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="web.NavBar" t-inherit-mode="extension" owl="1">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="after">
            <!-- Lateral Sliding Sidebar Panel with Search -->
            <div class="sidebar_panel" id="sidebar_panel">
                <div class="sidebar">
                    <div class="sidebar_close">
                        <a id="closeSidebar" class="text-white opacity-75" t-on-click="closeSidebar" style="cursor: pointer;">
                            <i class="fa fa-times fa-lg"/>
                        </a>
                    </div>

                    <!-- Search Container with Orange Search Button -->
                    <div class="search-container px-3 pt-3 pb-2">
                        <div class="search-input">
                            <div class="input-group">
                                <input type="search"
                                       autocomplete="off"
                                       placeholder="Buscar menús..."
                                       class="form-control"
                                       t-on-input="_searchMenusSchedule"/>
                                <div class="input-group-append">
                                    <div class="input-group-text">
                                        <i class="fa fa-search"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Search results -->
                        <div class="search-results d-none">
                            <div class="search_icons"/>
                        </div>
                    </div>

                    <!-- Sidebar Apps List -->
                    <div class="sidebar_menu">
                        <p class="sidebar_head">APLICACIONES</p>
                        <t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
                            <a t-att-data-menu-id="app.id"
                               t-att-data-menu-xmlid="app.xmlid"
                               t-att-data-action-id="app.actionID"
                               t-att-href="getMenuItemHref(app)"
                               t-on-click="() => this.onNavBarDropdownItemSelection(app)"
                               class="o_app d-flex align-items-center">
                                <img t-if="app.webIconData"
                                     class="app_menu_icon"
                                     t-attf-src="{{app.webIconData}}"
                                     t-att-alt="app.name"/>
                                <div t-else="" class="default_app_icon d-flex align-items-center justify-content-center">
                                    <i class="fa fa-th-large"/>
                                </div>
                                <span class="a_app_menu_title" t-esc="app.name"/>
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
