<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_type_kanban" model="ir.ui.view">
        <field name="name">sale.order.type.kanban (in sale_order_type_dashboard)</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <kanban class="o_account_kanban o_sale_dashboard_kanban" create="0" highlight_color="color">
                <field name="id" />
                <field name="name" />
                <field name="color" />
                <field name="description" />
                <field name="team_id" />
                <field name="user_id" />
                <field name="is_periodic" />
                <field name="billing_period_value" />
                <field name="billing_period_unit" />
                <field name="billing_period_display" />
                <field name="billing_day_of_month" />
                <field name="estimated_recurring_revenue" />
                <field name="mrr_revenue" />
                <field name="cash_flow_impact" />
                <field name="has_sale_entries" />
                <field name="state_quotation_count" />
                <field name="invoice_status_no_count" />
                <field name="invoice_status_ti_count" />
                <field name="kanban_dashboard_graph" />
                <templates>
                    <t t-name="card">
                        <!-- Top header -->
                        <div class="d-flex flex-row align-items-center justify-content-between">
                            <a class="fs-4 fw-bold" name="%(action_sale_quotation_from_dashboard)d" type="action">
                                <field name="name"/>
                            </a>
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle" t-if="record.is_periodic.raw_value">
                                <i class="fa fa-repeat me-1"/> <field name="billing_period_display"/>
                            </span>
                        </div>
                        <!-- Team Info -->
                        <div class="d-flex align-items-center gap-1 text-muted small mt-1" t-if="record.team_id.value">
                            <i class="fa fa-users text-primary me-1"/>
                            <strong><field name="team_id"/></strong>
                            <t t-if="record.user_id.value">
                                <span class="ms-1 text-secondary">· Líder: <field name="user_id"/></span>
                            </t>
                        </div>
                        <div class="d-flex flex-row align-items-center flex-wrap gap-2 mt-1" t-if="record.is_periodic.raw_value and record.estimated_recurring_revenue.raw_value">
                            <span class="badge bg-light text-dark border">
                                <i class="fa fa-calculator text-primary me-1"/> Proyección: <field name="estimated_recurring_revenue"/>
                            </span>
                            <span class="badge bg-light text-dark border" t-if="record.mrr_revenue.raw_value and record.billing_period_unit.raw_value != 'month'">
                                <i class="fa fa-line-chart text-info me-1"/> MRR: <field name="mrr_revenue"/>/mes
                            </span>
                            <span class="badge bg-light text-dark border" t-if="record.billing_day_of_month.raw_value">
                                <i class="fa fa-calendar text-success me-1"/> Cobro: Día <field name="billing_day_of_month"/>
                            </span>
                        </div>
                        <div class="text-muted small mt-1 lh-sm" t-if="record.description.value">
                            <field name="description"/>
                        </div>
                        <div class="text-muted small mt-1 lh-sm" t-else="">
                            Presupuestos y pedidos de venta
                        </div>

                        <!-- Card Body -->
                        <div class="mt-3 p-0 container-fluid">
                            <div class="row align-items-center mb-2">
                                <div class="col mb-3 mb-sm-0 o_kanban_primary_left">
                                    <button class="btn btn-primary" type="object" name="action_create_quotation">
                                        Nuevo
                                    </button>
                                </div>
                                <div class="col-auto text-end" name="kanban_primary_right">
                                    <div class="row">
                                        <div class="col overflow-hidden text-start">
                                            <a name="%(action_sale_quotation_from_dashboard)d" type="action" context="{'search_default_draft': 1}">
                                                <t t-out="record.state_quotation_count.value"/> Cotizaciones / Presupuestos
                                            </a>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col overflow-hidden text-start">
                                            <a name="%(action_sale_order_from_dashboard)d" type="action" context="{'search_default_to_invoice': 1}">
                                                <t t-out="record.invoice_status_ti_count.value"/> Esperando facturación
                                            </a>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col overflow-hidden text-start">
                                            <a name="%(action_sale_order_from_dashboard)d" type="action" context="{'search_default_upselling': 1}">
                                                <t t-out="record.invoice_status_no_count.value"/> Nada para facturar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Bottom Graph (Bar Chart) -->
                            <div class="row mt-auto">
                                <field name="kanban_dashboard_graph" graph_type="bar" widget="dashboard_graph"/>
                            </div>
                        </div>
                    </t>

                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-4">
                                    <h5 class="o_kanban_card_manage_title">
                                        <span>Ver</span>
                                    </h5>
                                    <div>
                                        <a name="%(action_sale_quotation_from_dashboard)d" type="action">
                                            Presupuestos
                                        </a>
                                    </div>
                                    <div>
                                        <a name="%(action_sale_order_from_dashboard)d" type="action">
                                            Pedidos de venta
                                        </a>
                                    </div>
                                    <div t-if="record.team_id.raw_value">
                                        <a type="object" name="action_open_team">
                                            Equipo de ventas
                                        </a>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <h5 class="o_kanban_card_manage_title">
                                        <span>Nuevo</span>
                                    </h5>
                                    <div>
                                        <a type="object" name="action_create_quotation">
                                            Cotización
                                        </a>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <h5 class="o_kanban_card_manage_title">
                                        <span>Informes</span>
                                    </h5>
                                    <div>
                                        <a name="%(action_sale_order_report_from_dashboard)d" type="action">
                                            Análisis de ventas
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_settings row mt-2 pt-2 border-top">
                                <field class="col-8" name="color" widget="kanban_color_picker"/>
                                <div class="col-4 text-end">
                                    <a class="dropdown-item" type="edit">Configuración</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
