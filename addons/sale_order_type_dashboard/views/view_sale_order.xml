<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_sale_quotation_from_dashboard" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="search_view_id" ref="sale.view_sales_order_filter" />
        <field name="context">
            {'default_order_type': active_id, 'search_default_draft': 1}
        </field>
        <field name="domain">[('order_type', '=', active_id)]</field>
    </record>

    <record id="action_sale_order_from_dashboard" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="sale.view_order_tree" />
        <field name="search_view_id" ref="sale.view_sales_order_filter" />
        <field name="context">
            {'default_order_type': active_id}
        </field>
        <field name="domain">[('order_type', '=', active_id), ('state', 'in', ('sale', 'done'))]</field>
    </record>

    <record id="action_sale_order_report_from_dashboard" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_order_type': active_id}</field>
    </record>
</odoo>
