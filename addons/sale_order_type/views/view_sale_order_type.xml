<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_type_tree" model="ir.ui.view">
        <field name="name">sale.order.type.tree</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <list string="Sale Order Types">
                <field name="sequence" widget="handle" />
                <field name="billing_period_unit" column_invisible="True" />
                <field name="name" />
                <field name="is_periodic" widget="boolean_toggle" string="Recurrente" />
                <field name="billing_period_display" widget="badge" decoration-info="billing_period_unit == 'month'" decoration-warning="billing_period_unit == 'year'" decoration-success="billing_period_unit in ('week', 'days')" />
                <field name="estimated_recurring_revenue" optional="show" />
                <field name="mrr_revenue" optional="show" string="MRR (Ingreso Mensual)" />
                <field name="sequence_id" />
                <field name="team_id" optional="show" />
                <field name="payment_term_id" />
                <field name="pricelist_id" />
                <field name="warehouse_id" groups="stock.group_stock_multi_warehouses" />
                <field name="description" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_sale_order_type_form" model="ir.ui.view">
        <field name="name">sale.order.type.form</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <form string="Sale Order Type">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field name="name" placeholder="ej. Sucursal Matriz, Pólizas Mensuales..." /></h1>
                    </div>
                    <group>
                        <group name="sequence_grp">
                            <field name="sequence_id" />
                            <field name="team_id" options="{'no_quick_create': True}" />
                            <field name="payment_term_id" />
                            <field name="pricelist_id" />
                        </group>
                        <group name="logistics_grp">
                            <field name="warehouse_id" groups="stock.group_stock_multi_warehouses" />
                            <field name="incoterm_id" />
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
                            <field name="is_periodic" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page name="subscription_plan_page" string="Plan de Suscripción / Recurrencia" invisible="not is_periodic">
                            <group>
                                <group name="recurrence_details" string="Período de Facturación">
                                    <label for="billing_period_value" string="Intervalo de Recurrencia"/>
                                    <div class="d-flex flex-row align-items-center gap-2">
                                        <field name="billing_period_value" style="width: 5rem;" />
                                        <field name="billing_period_unit" />
                                    </div>
                                    <field name="billing_period_display" readonly="1" />
                                    <field name="billing_first_day" invisible="billing_period_unit in ('days', 'week')" />
                                    <field name="billing_day_of_month" />
                                </group>
                                <group name="automation_details" string="Automatización &amp; Tolerancia">
                                    <label for="auto_close_limit" string="Días de Gracia"/>
                                    <div class="d-flex flex-row align-items-center gap-2">
                                        <field name="auto_close_limit" style="width: 5rem;" />
                                        <span>Días tras vencimiento</span>
                                    </div>
                                    <field name="invoice_mail_template_id" options="{'no_create': True}" />
                                </group>
                            </group>
                        </page>
                        <page name="cash_flow_page" string="Flujo de Efectivo &amp; MRR" invisible="not is_periodic">
                            <group>
                                <group name="cash_flow_grp" string="Proyección de Ingresos">
                                    <field name="cash_flow_impact" widget="boolean_toggle" />
                                    <field name="estimated_recurring_revenue" widget="monetary" />
                                    <field name="currency_id" invisible="1" />
                                </group>
                                <group name="mrr_grp" string="Cálculo Normalizado (MRR)">
                                    <field name="mrr_revenue" widget="monetary" readonly="1" />
                                    <div class="text-muted small" colspan="2">
                                        * El Ingreso Mensual Recurrente (MRR) se calcula automáticamente para permitir la proyección uniforme de contratos semanales, quincenales, mensuales y anuales.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page name="description_page" string="Descripción Operativa">
                            <field name="description" placeholder="Descripción interna o notas sobre este departamento, sucursal o póliza..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_type" model="ir.actions.act_window">
        <field name="name">Sale Order Types</field>
        <field name="res_model">sale.order.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sale_order_type"
        name="Sale Order Types"
        parent="sale.menu_sale_config"
        action="action_sale_order_type"
        sequence="2"
        groups="sales_team.group_sale_manager"
    />
</odoo>
