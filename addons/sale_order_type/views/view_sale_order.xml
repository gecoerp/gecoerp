<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_sale_order_type" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_order_type)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="order_type" options="{'no_create': True}" placeholder="Seleccionar tipo / sucursal..." />
            </field>
            <xpath expr="//page[@name='other_information']" position="after">
                <page name="subscription_info" string="Suscripción / Recurrencia" invisible="not is_subscription">
                    <group>
                        <group name="sub_details" string="Período &amp; Vigencia">
                            <field name="is_subscription" invisible="1" />
                            <field name="subscription_state" widget="radio" options="{'horizontal': True}" />
                            <field name="start_date" />
                            <field name="next_invoice_date" />
                            <field name="end_date" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_sale_order_type" model="ir.ui.view">
        <field name="name">sale.order.list.select (in sale_order_type)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="order_type" />
            </field>
            <xpath expr="//group" position="inside">
                <filter string="Sale Type" name="group_by_order_type" domain="[]" context="{'group_by': 'order_type'}" />
            </xpath>
        </field>
    </record>
</odoo>
